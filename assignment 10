#include <iostream>
#include <string>
using namespace std;

class Product {
private:
    int id;
    string name;
    float price;

public:
    // Constructor
    Product(int i, string n, float p) {
        id = i;
        name = n;
        price = p;

        cout << "Constructor called" << endl;
    }

    // Destructor
    ~Product() {
        cout << "Destructor called" << endl;
    }

    // Method to print details
    void printDetails() {
        cout << "ID: " << id << endl;
        cout << "Name: " << name << endl;
        cout << "Price: $" << price << endl;
    }
};

int main() {

    Product p1(101, "Notebook", 4.99);

    p1.printDetails();

    return 0;
}
